# Copy to .env and fill in real values. Never commit a real .env file.

# development | test | staging | production
# In production: SEED_DEMO_DATA must be false, SECRET_KEY must not be the
# default, and DATABASE_URL must point at PostgreSQL - the app refuses to
# boot in production mode otherwise (see core/config.validate_production_settings).
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for local dev (default if unset): sqlite+aiosqlite:///./aegis_ai.db
# PostgreSQL for staging/production: postgresql+asyncpg://user:password@host:5432/aegis_ai
DATABASE_URL=

SEED_DEMO_DATA=true

# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./evidence_storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1

# rules | anthropic | openai. Leave as "rules" unless you intend for the
# Copilot to send tenant compliance context to an external model.
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=

# JSON array or comma-separated list. Must match the field name exactly
# (BACKEND_CORS_ORIGINS, not CORS_ORIGINS) since Settings is case-sensitive.
BACKEND_CORS_ORIGINS=["http://localhost:3050","http://localhost:3001"]
